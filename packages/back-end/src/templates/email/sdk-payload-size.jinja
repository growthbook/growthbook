{% extends "base.jinja" %}
{% import "utils.jinja" as utils %}

{% block preview %}
  SDK Connection {{ connectionName|noHyperlink }} has a large payload
{% endblock %}

{% block title %}
  The SDK Connection "{{ connectionName|noHyperlink }}" has a large payload
{% endblock %}

{% block top %}
  <p>{{ message }}</p>
  {% if recommendations.length %}
    <p>Ways to shrink it:</p>
    <ul style='padding: 0; margin: 0 0 10px 0; list-style-type: disc;'>
      {% for recommendation in recommendations %}
        <li style='margin:0 0 10px 30px;'>{{ recommendation }}</li>
      {% endfor %}
    </ul>
  {% endif %}
  {{ utils.button("View SDK Connection", connectionUrl) }}
{% endblock %}

{% block bottom %}
  <p style='margin: 30px 0;'>You are receiving this email because you are an admin of this GrowthBook organization.</p>
{% endblock %}
