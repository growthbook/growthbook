{% extends "base.jinja" %}
{% import "utils.jinja" as utils %}

{% block preview %}
  Нажмите, чтобы сбросить пароль
{% endblock %}

{% block title %}
  Сброс пароля GrowthBook
{% endblock %}

{% block top %}
  <p style='margin: 0 0 30px;'>Нажмите кнопку ниже, чтобы сбросить пароль:</p>
  {{ utils.button("Сбросить", resetUrl) }}
{% endblock %}

{% block bottom %}
  <p style='margin: 30px 0;'>Если кнопка не работает, <a href="{{ resetUrl }}" style="color: #1f9adb;">нажмите здесь</a> или скопируйте ссылку в браузер: {{ resetUrl }}</p>
  <p>Ссылка действует 30 минут</p>
{% endblock %}
