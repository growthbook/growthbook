// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`funnel fact metric SQL matches the BigQuery snapshot 1`] = `"-- Fact Table: Events WITH __rawExperiment AS ( SELECT user_id, timestamp, variation_id FROM events ), __experimentExposures AS ( -- Viewed Experiment SELECT e.user_id as user_id, cast(e.variation_id as string) as variation, CAST(e.timestamp as DATETIME) as timestamp FROM __rawExperiment e WHERE e.experiment_id = '' AND e.timestamp >= '2023-01-01 00:00:00' AND e.timestamp <= '2023-01-31 00:00:00' ), __experimentUnits AS ( -- One row per user SELECT e.user_id AS user_id, ( CASE WHEN count(distinct e.variation) > 1 THEN '__multiple__' ELSE max(e.variation) END ) AS variation, MIN(e.timestamp) AS first_exposure_timestamp FROM __experimentExposures e GROUP BY e.user_id ), __distinctUsers AS ( SELECT user_id, variation, first_exposure_timestamp AS timestamp, date_trunc(first_exposure_timestamp, DAY) AS first_exposure_date FROM __experimentUnits ), __factTable as ( -- Fact Table (Events) SELECT user_id as user_id, CAST(m.timestamp as DATETIME) as timestamp, -- Checkout Funnel (step 1: view) CASE WHEN ((event_name = 'view')) THEN CAST(m.timestamp as DATETIME) ELSE NULL END AS m0_step_0_ts, -- Checkout Funnel (step 2: add_to_cart) CASE WHEN ((event_name = 'add_to_cart')) THEN CAST(m.timestamp as DATETIME) ELSE NULL END AS m0_step_1_ts, -- Checkout Funnel (step 3: purchase) CASE WHEN ((event_name = 'purchase')) THEN CAST(m.timestamp as DATETIME) ELSE NULL END AS m0_step_2_ts FROM ( SELECT user_id, timestamp, event_name, amount FROM events ) m WHERE m.timestamp >= '2023-01-01 00:00:00' AND m.timestamp <= '2023-01-31 00:00:00' AND ( (event_name = 'view') OR (event_name = 'add_to_cart') OR (event_name = 'purchase') ) ), __userMetricJoin as ( SELECT d.variation AS variation, d.timestamp AS timestamp, m.timestamp AS event_timestamp, d.user_id AS user_id, ( CASE WHEN m.timestamp >= DATETIME_ADD(d.timestamp, INTERVAL 24 HOUR) AND m.timestamp <= '2023-01-31 00:00:00' THEN m.m0_step_0_ts ELSE NULL END ) as m0_step_0_ts, ( CASE WHEN m.timestamp >= DATETIME_ADD(d.timestamp, INTERVAL 24 HOUR) AND m.timestamp <= '2023-01-31 00:00:00' THEN m.m0_step_1_ts ELSE NULL END ) as m0_step_1_ts, ( CASE WHEN m.timestamp >= DATETIME_ADD(d.timestamp, INTERVAL 24 HOUR) AND m.timestamp <= '2023-01-31 00:00:00' THEN m.m0_step_2_ts ELSE NULL END ) as m0_step_2_ts FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, MIN(umj.timestamp) AS timestamp, MIN(umj.m0_step_0_ts) AS m0_step_0_resolved_ts, ARRAY_AGG( umj.m0_step_1_ts IGNORE NULLS ORDER BY umj.m0_step_1_ts ) AS m0_step_1_arr, ARRAY_AGG( umj.m0_step_2_ts IGNORE NULLS ORDER BY umj.m0_step_2_ts ) AS m0_step_2_arr FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ), __funnelResolve_1 AS ( SELECT r.*, ( SELECT MIN(t) FROM UNNEST (r.m0_step_1_arr) AS t WHERE t >= DATETIME_SUB(r.m0_step_0_resolved_ts, INTERVAL 300 SECOND) AND t <= DATETIME_ADD(r.m0_step_0_resolved_ts, INTERVAL 7200 SECOND) ) AS m0_step_1_resolved_ts FROM __userMetricAgg r ), __funnelResolve_2 AS ( SELECT r.*, ( SELECT MIN(t) FROM UNNEST (r.m0_step_2_arr) AS t WHERE t >= DATETIME_SUB(r.m0_step_0_resolved_ts, INTERVAL 300 SECOND) AND t <= DATETIME_ADD(r.m0_step_0_resolved_ts, INTERVAL 86400 SECOND) ) AS m0_step_2_resolved_ts FROM __funnelResolve_1 r ), __unitMetrics AS ( SELECT r.*, CASE WHEN r.m0_step_0_resolved_ts IS NOT NULL THEN 1 ELSE 0 END AS m0_step_0_value, CASE WHEN r.m0_step_1_resolved_ts IS NOT NULL THEN 1 ELSE 0 END AS m0_step_1_value, CASE WHEN r.m0_step_2_resolved_ts IS NOT NULL THEN 1 ELSE 0 END AS m0_step_2_value FROM __funnelResolve_2 r ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast('fact__funnel' as string) as m0_id -- view , SUM(COALESCE(m.m0_step_0_value, 0)) AS m0_step_0_sum -- add_to_cart , SUM(COALESCE(m.m0_step_1_value, 0)) AS m0_step_1_sum -- purchase , SUM(COALESCE(m.m0_step_2_value, 0)) AS m0_step_2_sum FROM __unitMetrics m GROUP BY m.variation"`;

exports[`funnel fact metric SQL matches the Redshift snapshot 1`] = `"-- Fact Table: Events WITH __rawExperiment AS ( SELECT user_id, timestamp, variation_id FROM events ), __experimentExposures AS ( -- Viewed Experiment SELECT e.user_id as user_id, cast(e.variation_id as varchar) as variation, e.timestamp as timestamp FROM __rawExperiment e WHERE e.experiment_id = '' AND e.timestamp >= '2023-01-01 00:00:00' AND e.timestamp <= '2023-01-31 00:00:00' ), __experimentUnits AS ( -- One row per user SELECT e.user_id AS user_id, ( CASE WHEN count(distinct e.variation) > 1 THEN '__multiple__' ELSE max(e.variation) END ) AS variation, MIN(e.timestamp) AS first_exposure_timestamp FROM __experimentExposures e GROUP BY e.user_id ), __distinctUsers AS ( SELECT user_id, variation, first_exposure_timestamp AS timestamp, date_trunc('day', first_exposure_timestamp) AS first_exposure_date FROM __experimentUnits ), __factTable as ( -- Fact Table (Events) SELECT user_id as user_id, m.timestamp as timestamp, -- Checkout Funnel (step 1: view) CASE WHEN ((event_name = 'view')) THEN m.timestamp ELSE NULL END AS m0_step_0_ts, -- Checkout Funnel (step 2: add_to_cart) CASE WHEN ((event_name = 'add_to_cart')) THEN m.timestamp ELSE NULL END AS m0_step_1_ts, -- Checkout Funnel (step 3: purchase) CASE WHEN ((event_name = 'purchase')) THEN m.timestamp ELSE NULL END AS m0_step_2_ts FROM ( SELECT user_id, timestamp, event_name, amount FROM events ) m WHERE m.timestamp >= '2023-01-01 00:00:00' AND m.timestamp <= '2023-01-31 00:00:00' AND ( (event_name = 'view') OR (event_name = 'add_to_cart') OR (event_name = 'purchase') ) ), __userMetricJoin as ( SELECT d.variation AS variation, d.timestamp AS timestamp, m.timestamp AS event_timestamp, d.user_id AS user_id, ( CASE WHEN m.timestamp >= d.timestamp + INTERVAL '24 hours' AND m.timestamp <= '2023-01-31 00:00:00' THEN m.m0_step_0_ts ELSE NULL END ) as m0_step_0_ts, ( CASE WHEN m.timestamp >= d.timestamp + INTERVAL '24 hours' AND m.timestamp <= '2023-01-31 00:00:00' THEN m.m0_step_1_ts ELSE NULL END ) as m0_step_1_ts, ( CASE WHEN m.timestamp >= d.timestamp + INTERVAL '24 hours' AND m.timestamp <= '2023-01-31 00:00:00' THEN m.m0_step_2_ts ELSE NULL END ) as m0_step_2_ts FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, MIN(umj.timestamp) AS timestamp, MIN(umj.m0_step_0_ts) AS m0_step_0_resolved_ts, SPLIT_TO_ARRAY( LISTAGG(CAST(umj.m0_step_1_ts AS VARCHAR), '||~gb~||') WITHIN GROUP ( ORDER BY umj.event_timestamp ), '||~gb~||' ) AS m0_step_1_arr, SPLIT_TO_ARRAY( LISTAGG(CAST(umj.m0_step_2_ts AS VARCHAR), '||~gb~||') WITHIN GROUP ( ORDER BY umj.event_timestamp ), '||~gb~||' ) AS m0_step_2_arr FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ), __funnelResolve_1 AS ( SELECT r.*, ( SELECT MIN(t::timestamp) FROM r.m0_step_1_arr AS t WHERE t::timestamp >= DATEADD(second, -300, r.m0_step_0_resolved_ts) AND t::timestamp <= DATEADD(second, 7200, r.m0_step_0_resolved_ts) ) AS m0_step_1_resolved_ts FROM __userMetricAgg r ), __funnelResolve_2 AS ( SELECT r.*, ( SELECT MIN(t::timestamp) FROM r.m0_step_2_arr AS t WHERE t::timestamp >= DATEADD(second, -300, r.m0_step_0_resolved_ts) AND t::timestamp <= DATEADD(second, 86400, r.m0_step_0_resolved_ts) ) AS m0_step_2_resolved_ts FROM __funnelResolve_1 r ), __unitMetrics AS ( SELECT r.*, CASE WHEN r.m0_step_0_resolved_ts IS NOT NULL THEN 1 ELSE 0 END AS m0_step_0_value, CASE WHEN r.m0_step_1_resolved_ts IS NOT NULL THEN 1 ELSE 0 END AS m0_step_1_value, CASE WHEN r.m0_step_2_resolved_ts IS NOT NULL THEN 1 ELSE 0 END AS m0_step_2_value FROM __funnelResolve_2 r ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast('fact__funnel' as varchar) as m0_id -- view , SUM(COALESCE(m.m0_step_0_value, 0)) AS m0_step_0_sum -- add_to_cart , SUM(COALESCE(m.m0_step_1_value, 0)) AS m0_step_1_sum -- purchase , SUM(COALESCE(m.m0_step_2_value, 0)) AS m0_step_2_sum FROM __unitMetrics m GROUP BY m.variation"`;

exports[`funnel fact metric SQL steps spanning several fact tables matches the BigQuery snapshot 1`] = `"-- Cross-Fact Table Metrics: Events & Orders WITH __rawExperiment AS ( SELECT user_id, timestamp, variation_id FROM events ), __experimentExposures AS ( -- Viewed Experiment SELECT e.user_id as user_id, cast(e.variation_id as string) as variation, CAST(e.timestamp as DATETIME) as timestamp FROM __rawExperiment e WHERE e.experiment_id = '' AND e.timestamp >= '2023-01-01 00:00:00' AND e.timestamp <= '2023-01-31 00:00:00' ), __experimentUnits AS ( -- One row per user SELECT e.user_id AS user_id, ( CASE WHEN count(distinct e.variation) > 1 THEN '__multiple__' ELSE max(e.variation) END ) AS variation, MIN(e.timestamp) AS first_exposure_timestamp FROM __experimentExposures e GROUP BY e.user_id ), __distinctUsers AS ( SELECT user_id, variation, first_exposure_timestamp AS timestamp, date_trunc(first_exposure_timestamp, DAY) AS first_exposure_date FROM __experimentUnits ), __factTable as ( -- Fact Table (Events) SELECT user_id as user_id, CAST(m.timestamp as DATETIME) as timestamp, -- Checkout Funnel (step 1: view) CASE WHEN ((event_name = 'view')) THEN CAST(m.timestamp as DATETIME) ELSE NULL END AS m0_step_0_ts FROM ( SELECT user_id, timestamp, event_name, amount FROM events ) m WHERE m.timestamp >= '2023-01-01 00:00:00' AND m.timestamp <= '2023-01-31 00:00:00' AND (event_name = 'view') ), __userMetricJoin as ( SELECT d.variation AS variation, d.timestamp AS timestamp, m.timestamp AS event_timestamp, d.user_id AS user_id, ( CASE WHEN m.timestamp >= DATETIME_ADD(d.timestamp, INTERVAL 24 HOUR) AND m.timestamp <= '2023-01-31 00:00:00' THEN m.m0_step_0_ts ELSE NULL END ) as m0_step_0_ts FROM __distinctUsers d LEFT JOIN __factTable m ON (m.user_id = d.user_id) ), __userMetricAgg as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, MIN(umj.timestamp) AS timestamp, MIN(umj.m0_step_0_ts) AS m0_step_0_resolved_ts FROM __userMetricJoin umj GROUP BY umj.variation, umj.user_id ), __factTable1 as ( -- Fact Table (Orders) SELECT user_id as user_id, CAST(m.timestamp as DATETIME) as timestamp, -- Checkout Funnel (step 2: purchase) CAST(m.timestamp as DATETIME) AS m0_step_1_ts FROM ( SELECT user_id, timestamp, amount FROM orders ) m WHERE m.timestamp >= '2023-01-01 00:00:00' AND m.timestamp <= '2023-01-31 00:00:00' ), __userMetricJoin1 as ( SELECT d.variation AS variation, d.timestamp AS timestamp, m.timestamp AS event_timestamp, d.user_id AS user_id, ( CASE WHEN m.timestamp >= DATETIME_ADD(d.timestamp, INTERVAL 24 HOUR) AND m.timestamp <= '2023-01-31 00:00:00' THEN m.m0_step_1_ts ELSE NULL END ) as m0_step_1_ts FROM __distinctUsers d LEFT JOIN __factTable1 m ON (m.user_id = d.user_id) ), __userMetricAgg1 as ( -- Add in the aggregate metric value for each user SELECT umj.variation, umj.user_id, ARRAY_AGG( umj.m0_step_1_ts IGNORE NULLS ORDER BY umj.m0_step_1_ts ) AS m0_step_1_arr FROM __userMetricJoin1 umj GROUP BY umj.variation, umj.user_id ), __unitMetricsBase AS ( SELECT m.*, m1.m0_step_1_arr AS m0_step_1_arr FROM __userMetricAgg m LEFT JOIN __userMetricAgg1 m1 ON (m1.user_id = m.user_id) ), __funnelResolve_1 AS ( SELECT r.*, ( SELECT MIN(t) FROM UNNEST (r.m0_step_1_arr) AS t WHERE t >= r.m0_step_0_resolved_ts AND t <= DATETIME_ADD(r.m0_step_0_resolved_ts, INTERVAL 86400 SECOND) ) AS m0_step_1_resolved_ts FROM __unitMetricsBase r ), __unitMetrics AS ( SELECT r.*, CASE WHEN r.m0_step_0_resolved_ts IS NOT NULL THEN 1 ELSE 0 END AS m0_step_0_value, CASE WHEN r.m0_step_1_resolved_ts IS NOT NULL THEN 1 ELSE 0 END AS m0_step_1_value FROM __funnelResolve_1 r ) -- One row per variation/dimension with aggregations SELECT m.variation AS variation, COUNT(*) AS users, cast('fact__cross_funnel' as string) as m0_id -- view , SUM(COALESCE(m.m0_step_0_value, 0)) AS m0_step_0_sum -- purchase , SUM(COALESCE(m.m0_step_1_value, 0)) AS m0_step_1_sum FROM __unitMetrics m GROUP BY m.variation"`;
