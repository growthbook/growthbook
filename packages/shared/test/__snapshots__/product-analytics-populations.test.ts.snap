// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`population-backed proportions generated daily SQL (SQLite) matches the query with the mobile revenue population 1`] = `
"WITH
  _factTable0 AS (
    SELECT
      *
    FROM
      (
        -- Raw fact table SQL
        SELECT
          *
        FROM
          events
      ) t
    WHERE
      timestamp >= '2026-09-01'
      AND timestamp <= '2026-09-03'
      AND (
        (event_name = 'Purchase')
        OR (device_type = 'mobile')
      )
  ),
  _factTable0_rows AS (
    SELECT
      date(timestamp) AS dimension0,
      user_id AS unit0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m0_rows,
      CASE
        WHEN ((device_type = 'mobile')) THEN revenue
        ELSE NULL
      END AS pop,
      CASE
        WHEN ((device_type = 'mobile')) THEN 1
        ELSE NULL
      END AS pop_rows
    FROM
      _factTable0
  ),
  _factTable0_unit0 AS (
    SELECT
      unit0,
      dimension0,
      CASE
        WHEN COUNT(m0_rows) > 0 THEN MAX(m0)
        ELSE NULL
      END AS m0,
      CASE
        WHEN COUNT(pop_rows) > 0 THEN CASE
          WHEN (SUM(pop) > 10) THEN 1
          ELSE NULL
        END
        ELSE NULL
      END AS pop
    FROM
      _factTable0_rows
    GROUP BY
      unit0,
      dimension0
  ),
  _factTable0_unit0_rollup AS (
    SELECT
      dimension0,
      CAST(
        COALESCE(
          SUM(
            CASE
              WHEN pop = 1
              AND unit0 IS NOT NULL THEN m0
              ELSE NULL
            END
          ),
          0
        ) AS REAL
      ) AS m0_numerator,
      CAST(
        COUNT(
          CASE
            WHEN pop = 1
            AND unit0 IS NOT NULL THEN m0
            ELSE NULL
          END
        ) AS REAL
      ) AS m0_denominator,
      CAST(
        SUM(
          CASE
            WHEN pop = 1
            AND unit0 IS NOT NULL THEN 1
            ELSE 0
          END
        ) AS REAL
      ) AS m0_population_count
    FROM
      _factTable0_unit0
    GROUP BY
      dimension0
  )
SELECT
  dimension0,
  m0_numerator AS m0_numerator,
  m0_denominator AS m0_denominator,
  m0_population_count AS m0_population_count
FROM
  _factTable0_unit0_rollup"
`;

exports[`population-backed proportions generated daily SQL (SQLite) matches the query without a population 1`] = `
"WITH
  _factTable0 AS (
    SELECT
      *
    FROM
      (
        -- Raw fact table SQL
        SELECT
          *
        FROM
          events
      ) t
    WHERE
      timestamp >= '2026-09-01'
      AND timestamp <= '2026-09-03'
      AND (event_name = 'Purchase')
  ),
  _factTable0_rows AS (
    SELECT
      date(timestamp) AS dimension0,
      user_id AS unit0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m0
    FROM
      _factTable0
  ),
  _factTable0_unit0 AS (
    SELECT
      unit0,
      dimension0,
      MAX(m0) AS m0
    FROM
      _factTable0_rows
    GROUP BY
      unit0,
      dimension0
  ),
  _factTable0_unit0_rollup AS (
    SELECT
      dimension0,
      CAST(SUM(m0) AS REAL) AS m0_numerator,
      CAST(COUNT(m0) AS REAL) AS m0_denominator
    FROM
      _factTable0_unit0
    GROUP BY
      dimension0
  )
SELECT
  dimension0,
  m0_numerator AS m0_numerator,
  m0_denominator AS m0_denominator
FROM
  _factTable0_unit0_rollup"
`;
