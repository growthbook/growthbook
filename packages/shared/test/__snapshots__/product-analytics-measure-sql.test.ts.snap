`;

exports[`SQL for each kind of measured value fact table values counts rows, sums a column and counts distinct units 1`] = `
"WITH
  _factTable0 AS (
    SELECT
      *
    FROM
      (
        -- Raw fact table SQL
        SELECT
          *
        FROM
          events
      ) t
    WHERE
      timestamp >= '2026-09-01 00:00:00'
      AND timestamp <= '2026-09-03 00:00:00'
      AND (event_name = 'Purchase')
  ),
  _factTable0_rows AS (
    SELECT
      user_id AS unit0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN revenue
        ELSE NULL
      END AS m1,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m2
    FROM
      _factTable0
  ),
  _factTable0_unit0 AS (
    SELECT
      unit0,
      SUM(m0) AS m0,
      SUM(m1) AS m1,
      MAX(m2) AS m2
    FROM
      _factTable0_rows
    GROUP BY
      unit0
  ),
  _factTable0_unit0_rollup AS (
    SELECT
      CAST(SUM(m0) AS FLOAT) AS m0_numerator,
      CAST(COUNT(m0) AS FLOAT) AS m0_denominator,
      CAST(SUM(m1) AS FLOAT) AS m1_numerator,
      CAST(COUNT(m1) AS FLOAT) AS m1_denominator,
      CAST(SUM(m2) AS FLOAT) AS m2_numerator,
      CAST(COUNT(m2) AS FLOAT) AS m2_denominator
    FROM
      _factTable0_unit0
  )
SELECT
  m0_numerator AS m0_numerator,
  m0_denominator AS m0_denominator,
  m1_numerator AS m1_numerator,
  m1_denominator AS m1_denominator,
  m2_numerator AS m2_numerator,
  m2_denominator AS m2_denominator
FROM
  _factTable0_unit0_rollup"
`;

exports[`SQL for each kind of measured value mean metrics a column capped at a percentile 1`] = `
"WITH
  _factTable0 AS (
    SELECT
      *
    FROM
      (
        -- Raw fact table SQL
        SELECT
          *
        FROM
          events
      ) t
    WHERE
      timestamp >= '2026-09-01 00:00:00'
      AND timestamp <= '2026-09-03 00:00:00'
      AND (event_name = 'Purchase')
  ),
  _factTable0_percentile_caps AS (
    SELECT
      APPROX_PERCENTILE (
        CASE
          WHEN ((event_name = 'Purchase')) THEN revenue
          ELSE NULL
        END,
        0.99
      ) AS m0_cap
    FROM
      _factTable0
  ),
  _factTable0_rows AS (
    SELECT
      user_id AS unit0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN LEAST(revenue, COALESCE(m0_cap, revenue))
        ELSE NULL
      END AS m0
    FROM
      _factTable0
      CROSS JOIN _factTable0_percentile_caps
  ),
  _factTable0_unit0 AS (
    SELECT
      unit0,
      SUM(m0) AS m0
    FROM
      _factTable0_rows
    GROUP BY
      unit0
  ),
  _factTable0_unit0_rollup AS (
    SELECT
      CAST(SUM(m0) AS FLOAT) AS m0_numerator,
      CAST(COUNT(m0) AS FLOAT) AS m0_denominator
    FROM
      _factTable0_unit0
  )
SELECT
  m0_numerator AS m0_numerator,
  m0_denominator AS m0_denominator
FROM
  _factTable0_unit0_rollup"
`;

