exports[`SQL for each kind of measured value several metrics on one fact table every kind of measured value together 1`] = `
"WITH
  _factTable0 AS (
    SELECT
      *
    FROM
      (
        -- Raw fact table SQL
        SELECT
          *
        FROM
          events
      ) t
    WHERE
      timestamp >= '2026-09-01 00:00:00'
      AND timestamp <= '2026-09-03 00:00:00'
      AND (event_name = 'Purchase')
  ),
  _factTable0_rows AS (
    SELECT
      user_id AS unit0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN revenue
        ELSE NULL
      END AS m0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN revenue
        ELSE NULL
      END AS m1,
      CASE
        WHEN ((event_name = 'Purchase')) THEN product_id
        ELSE NULL
      END AS m2,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m2_rows,
      CASE
        WHEN ((event_name = 'Purchase')) THEN users_hll
        ELSE NULL
      END AS m3,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m3_rows,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m4,
      CASE
        WHEN ((event_name = 'Purchase')) THEN date_trunc('day', timestamp)
        ELSE NULL
      END AS m5,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m5_rows,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m6
    FROM
      _factTable0
  ),
  _factTable0_unit0 AS (
    SELECT
      unit0,
      SUM(m0) AS m0,
      MAX(m1) AS m1,
      CASE
        WHEN COUNT(m2_rows) > 0 THEN COUNT(DISTINCT m2)
        ELSE NULL
      END AS m2,
      CASE
        WHEN COUNT(m3_rows) > 0 THEN HLL_COUNT (HLL_MERGE (m3))
        ELSE NULL
      END AS m3,
      SUM(m4) AS m4,
      CASE
        WHEN COUNT(m5_rows) > 0 THEN COUNT(DISTINCT m5)
        ELSE NULL
      END AS m5,
      MAX(m6) AS m6
    FROM
      _factTable0_rows
    GROUP BY
      unit0
  ),
  _factTable0_unit0_rollup AS (
    SELECT
      CAST(SUM(m0) AS FLOAT) AS m0_numerator,
      CAST(COUNT(m0) AS FLOAT) AS m0_denominator,
      CAST(SUM(m1) AS FLOAT) AS m1_numerator,
      CAST(COUNT(m1) AS FLOAT) AS m1_denominator,
      CAST(SUM(m2) AS FLOAT) AS m2_numerator,
      CAST(COUNT(m2) AS FLOAT) AS m2_denominator,
      CAST(SUM(m3) AS FLOAT) AS m3_numerator,
      CAST(COUNT(m3) AS FLOAT) AS m3_denominator,
      CAST(SUM(m4) AS FLOAT) AS m4_numerator,
      CAST(COUNT(m4) AS FLOAT) AS m4_denominator,
      CAST(SUM(m5) AS FLOAT) AS m5_numerator,
      CAST(COUNT(m5) AS FLOAT) AS m5_denominator,
      CAST(SUM(m6) AS FLOAT) AS m6_numerator,
      CAST(COUNT(m6) AS FLOAT) AS m6_denominator
    FROM
      _factTable0_unit0
  )
SELECT
  m0_numerator AS m0_numerator,
  m0_denominator AS m0_denominator,
  m1_numerator AS m1_numerator,
  m1_denominator AS m1_denominator,
  m2_numerator AS m2_numerator,
  m2_denominator AS m2_denominator,
  m3_numerator AS m3_numerator,
  m3_denominator AS m3_denominator,
  m4_numerator AS m4_numerator,
  m4_denominator AS m4_denominator,
  m5_numerator AS m5_numerator,
  m5_denominator AS m5_denominator,
  m6_numerator AS m6_numerator,
  m6_denominator AS m6_denominator
FROM
  _factTable0_unit0_rollup"
`;
