// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`SQL for each kind of measured value Population values counts units whose column total passes an aggregate filter 1`] = `
"WITH
  _factTable0 AS (
    SELECT
      *
    FROM
      (
        -- Raw fact table SQL
        SELECT
          *
        FROM
          events
      ) t
    WHERE
      timestamp >= '2026-09-01 00:00:00'
      AND timestamp <= '2026-09-03 00:00:00'
      AND (event_name = 'Purchase')
  ),
  _factTable0_rows AS (
    SELECT
      user_id AS unit0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN revenue
        ELSE NULL
      END AS m0
    FROM
      _factTable0
  ),
  _factTable0_unit0 AS (
    SELECT
      unit0,
      CASE
        WHEN (SUM(m0) > 10) THEN 1
        ELSE NULL
      END AS m0
    FROM
      _factTable0_rows
    GROUP BY
      unit0
  ),
  _factTable0_unit0_rollup AS (
    SELECT
      CAST(SUM(m0) AS FLOAT) AS m0_numerator,
      CAST(COUNT(m0) AS FLOAT) AS m0_denominator
    FROM
      _factTable0_unit0
  )
SELECT
  m0_numerator AS m0_numerator,
  m0_denominator AS m0_denominator
FROM
  _factTable0_unit0_rollup"
`;

