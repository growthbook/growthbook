exports[`SQL for each kind of measured value metrics with a Population restricts each metric to the Population's members 1`] = `
"WITH
  _factTable0 AS (
    SELECT
      *
    FROM
      (
        -- Raw fact table SQL
        SELECT
          *
        FROM
          events
      ) t
    WHERE
      timestamp >= '2026-09-01 00:00:00'
      AND timestamp <= '2026-09-03 00:00:00'
      AND (event_name = 'Purchase')
  ),
  _factTable0_rows AS (
    SELECT
      user_id AS unit0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN revenue
        ELSE NULL
      END AS m0,
      CASE
        WHEN ((event_name = 'Purchase')) THEN 1
        ELSE NULL
      END AS m1,
      CASE
        WHEN ((event_name = 'Purchase')) THEN revenue
        ELSE NULL
      END AS population_count
    FROM
      _factTable0
  ),
  _factTable0_unit0 AS (
    SELECT
      unit0,
      SUM(m0) AS m0,
      MAX(m1) AS m1,
      CASE
        WHEN (SUM(population_count) > 10) THEN 1
        ELSE NULL
      END AS population_count
    FROM
      _factTable0_rows
    GROUP BY
      unit0
  ),
  _factTable0_unit0_rollup AS (
    SELECT
      CAST(SUM(m0) AS FLOAT) AS m0_numerator,
      CAST(COUNT(m0) AS FLOAT) AS m0_denominator,
      CAST(SUM(m1) AS FLOAT) AS m1_numerator,
      CAST(COUNT(m1) AS FLOAT) AS m1_denominator,
      CAST(SUM(population_count) AS FLOAT) AS population_count_numerator
    FROM
      _factTable0_unit0
    WHERE
      population_count IS NOT NULL
  )
SELECT
  m0_numerator AS m0_numerator,
  m0_denominator AS m0_denominator,
  m1_numerator AS m1_numerator,
  m1_denominator AS m1_denominator,
  population_count_numerator AS population_count_numerator
FROM
  _factTable0_unit0_rollup"
`;

