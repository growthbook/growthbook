  ),
  __pop_step1_agg AS (
    SELECT
      r.unit_id
    FROM
      __pop_step0 p
      JOIN __pop_step1_rows r ON (r.unit_id = p.unit_id)
    WHERE
      r.ts >= p.s0_ts
    GROUP BY
      r.unit_id
  ),
  __pop_step1 AS (
    SELECT
      p.unit_id,
      p.s0_ts,
      CASE
        WHEN p.s0_ts > p.qualified_ts THEN p.s0_ts
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step0 p
    WHERE
      p.unit_id NOT IN (
        SELECT
          unit_id
        FROM
          __pop_step1_agg
      )
  ),
  __population_members AS (
    SELECT
      unit_id AS user_id,
      qualified_ts AS joined_ts
    FROM
      __pop_step1
  )
SELECT
  COUNT(*) AS members
FROM
  __population_members"
`;

exports[`example Population SQL Signed up, then under 10 minutes active in their first week 1`] = `
"WITH
  __pop_ft0 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Signups)
        SELECT
          user_id,
          created_at AS timestamp,
          plan
        FROM
          app.signups
      ) t
    WHERE
      timestamp <= '2026-10-15 00:00:00'
      AND timestamp >= '2026-08-16 00:00:00'
  ),
  __pop_ft1 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Events)
        SELECT
          uid,
          event_time,
          event_name,
          path,
          properties
        FROM
          analytics.events
      ) t
    WHERE
      event_time <= '2026-10-15 00:00:00'
      AND event_time >= '2026-08-16 00:00:00'
      AND (event_name = 'session_end')
  ),
  __pop_step0_rows AS (
    SELECT
      user_id AS unit_id,
      timestamp AS ts
    FROM
      __pop_ft0
    WHERE
      user_id IS NOT NULL
      AND timestamp >= '2026-08-16 00:00:00'
  ),
  __pop_step1_rows AS (
    SELECT
      uid AS unit_id,
      event_time AS ts,
      COALESCE(
        JSON_EXTRACT_PATH_TEXT(properties::json, 'seconds_active')::float,
        0
      ) AS value
    FROM
      __pop_ft1
    WHERE
      uid IS NOT NULL
      AND (event_name = 'session_end')
  ),
  __pop_step0_agg AS (
    SELECT
      r.unit_id,
      MIN(r.ts) AS match_ts
    FROM
      __pop_step0_rows r
    GROUP BY
      r.unit_id
  ),
  __pop_step0 AS (
    SELECT
      a.unit_id,
      a.match_ts AS s0_ts,
      a.match_ts AS qualified_ts
    FROM
      __pop_step0_agg a
  ),
  __pop_step1_running AS (
    SELECT
      r.unit_id,
      r.ts,
      r.value,
      SUM(r.value) OVER (
        PARTITION BY
          r.unit_id
        ORDER BY
          r.ts ROWS BETWEEN UNBOUNDED PRECEDING
          AND CURRENT ROW
      ) AS running_total
    FROM
      __pop_step0 p
      JOIN __pop_step1_rows r ON (r.unit_id = p.unit_id)
    WHERE
      r.ts >= p.s0_ts
      AND r.ts <= p.s0_ts + INTERVAL '604800 seconds'
  ),
  __pop_step1_agg AS (
    SELECT
      unit_id,
      SUM(value) AS total,
      COALESCE(
        MIN(
          CASE
            WHEN running_total < 600 THEN ts
          END
        ),
        MAX(ts)
      ) AS match_ts
    FROM
      __pop_step1_running
    GROUP BY
      unit_id
  ),
  __pop_step1 AS (
    SELECT
      p.unit_id,
      p.s0_ts,
      a.match_ts AS s1_ts,
      CASE
        WHEN p.s0_ts + INTERVAL '604800 seconds' > p.qualified_ts THEN p.s0_ts + INTERVAL '604800 seconds'
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step0 p
      JOIN __pop_step1_agg a ON (a.unit_id = p.unit_id)
    WHERE
      a.total < 600
      AND p.s0_ts + INTERVAL '604800 seconds' <= CAST('2026-10-15 00:00:00' AS TIMESTAMP)
    UNION ALL
    SELECT
      p.unit_id,
      p.s0_ts,
      CAST(NULL AS TIMESTAMP) AS s1_ts,
      CASE
        WHEN p.s0_ts + INTERVAL '604800 seconds' > p.qualified_ts THEN p.s0_ts + INTERVAL '604800 seconds'
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step0 p
    WHERE
      p.unit_id NOT IN (
        SELECT
          unit_id
        FROM
          __pop_step1_agg
      )
      AND p.s0_ts + INTERVAL '604800 seconds' <= CAST('2026-10-15 00:00:00' AS TIMESTAMP)
  ),
  __population_members AS (
    SELECT
      unit_id AS user_id,
      qualified_ts AS joined_ts
    FROM
      __pop_step1
  )
SELECT
  COUNT(*) AS members
FROM
  __population_members"
`;

exports[`example Population SQL Signed up, then under 10 minutes active in their first week on BigQuery 1`] = `
"WITH
  __pop_ft0 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Signups)
        SELECT
          user_id,
          created_at AS timestamp,
          plan
        FROM
          app.signups
      ) t
    WHERE
      timestamp <= '2026-10-15 00:00:00'
      AND timestamp >= '2026-08-16 00:00:00'
  ),
  __pop_ft1 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Events)
        SELECT
          uid,
          event_time,
          event_name,
          path,
          properties
        FROM
          analytics.events
      ) t
    WHERE
      event_time <= '2026-10-15 00:00:00'
      AND event_time >= '2026-08-16 00:00:00'
      AND (event_name = 'session_end')
  ),
  __pop_step0_rows AS (
    SELECT
      user_id AS unit_id,
      CAST(timestamp as DATETIME) AS ts
    FROM
      __pop_ft0
    WHERE
      user_id IS NOT NULL
      AND timestamp >= '2026-08-16 00:00:00'
  ),
  __pop_step1_rows AS (
    SELECT
      uid AS unit_id,
      CAST(event_time as DATETIME) AS ts,
      COALESCE(
        CAST(
          JSON_VALUE(properties, '$.seconds_active') AS FLOAT64
        ),
        0
      ) AS value
    FROM
      __pop_ft1
    WHERE
      uid IS NOT NULL
      AND (event_name = 'session_end')
  ),
  __pop_step0_agg AS (
    SELECT
      r.unit_id,
      MIN(r.ts) AS match_ts
    FROM
      __pop_step0_rows r
    GROUP BY
      r.unit_id
  ),
  __pop_step0 AS (
    SELECT
      a.unit_id,
      a.match_ts AS s0_ts,
      a.match_ts AS qualified_ts
    FROM
      __pop_step0_agg a
  ),
  __pop_step1_running AS (
    SELECT
      r.unit_id,
      r.ts,
      r.value,
      SUM(r.value) OVER (
        PARTITION BY
          r.unit_id
        ORDER BY
          r.ts ROWS BETWEEN UNBOUNDED PRECEDING
          AND CURRENT ROW
      ) AS running_total
    FROM
      __pop_step0 p
      JOIN __pop_step1_rows r ON (r.unit_id = p.unit_id)
    WHERE
      r.ts >= p.s0_ts
      AND r.ts <= DATETIME_ADD(p.s0_ts, INTERVAL 604800 SECOND)
  ),
  __pop_step1_agg AS (
    SELECT
      unit_id,
      SUM(value) AS total,
      COALESCE(
        MIN(
          CASE
            WHEN running_total < 600 THEN ts
          END
        ),
        MAX(ts)
      ) AS match_ts
    FROM
      __pop_step1_running
    GROUP BY
      unit_id
  ),
  __pop_step1 AS (
    SELECT
      p.unit_id,
      p.s0_ts,
      a.match_ts AS s1_ts,
      CASE
        WHEN DATETIME_ADD(p.s0_ts, INTERVAL 604800 SECOND) > p.qualified_ts THEN DATETIME_ADD(p.s0_ts, INTERVAL 604800 SECOND)
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step0 p
      JOIN __pop_step1_agg a ON (a.unit_id = p.unit_id)
    WHERE
      a.total < 600
      AND DATETIME_ADD(p.s0_ts, INTERVAL 604800 SECOND) <= CAST(
        CAST('2026-10-15 00:00:00' AS TIMESTAMP) as DATETIME
      )
    UNION ALL
    SELECT
      p.unit_id,
      p.s0_ts,
      CAST(CAST(NULL AS TIMESTAMP) as DATETIME) AS s1_ts,
      CASE
        WHEN DATETIME_ADD(p.s0_ts, INTERVAL 604800 SECOND) > p.qualified_ts THEN DATETIME_ADD(p.s0_ts, INTERVAL 604800 SECOND)
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step0 p
    WHERE
      p.unit_id NOT IN (
        SELECT
          unit_id
        FROM
          __pop_step1_agg
      )
      AND DATETIME_ADD(p.s0_ts, INTERVAL 604800 SECOND) <= CAST(
        CAST('2026-10-15 00:00:00' AS TIMESTAMP) as DATETIME
      )
  ),
  __population_members AS (
    SELECT
      unit_id AS user_id,
      qualified_ts AS joined_ts
    FROM
      __pop_step1
  )
SELECT
  COUNT(*) AS members
FROM
  __population_members"
`;

exports[`example Population SQL Spent $500, then ordered twice more 1`] = `
"WITH
  __pop_ft0 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Orders)
        SELECT
          user_id,
          ordered_at AS timestamp,
          revenue,
          country
        FROM
          shop.orders
      ) t
    WHERE
      timestamp <= '2026-10-15 00:00:00'
      AND timestamp >= '2026-04-18 00:00:00'
  ),
  __pop_step0_rows AS (
    SELECT
      user_id AS unit_id,
      timestamp AS ts,
      COALESCE(revenue, 0) AS value
    FROM
      __pop_ft0
    WHERE
      user_id IS NOT NULL
      AND (country IN ('US', 'CA'))
      AND timestamp >= '2026-04-18 00:00:00'
  ),
  __pop_step1_rows AS (
    SELECT
      user_id AS unit_id,
      timestamp AS ts,
      1 AS value
    FROM
      __pop_ft0
    WHERE
      user_id IS NOT NULL
  ),
  __pop_step0_running AS (
    SELECT
      r.unit_id,
      r.ts,
      r.value,
      SUM(r.value) OVER (
        PARTITION BY
          r.unit_id
        ORDER BY
          r.ts ROWS BETWEEN UNBOUNDED PRECEDING
          AND CURRENT ROW
      ) AS running_total
    FROM
      __pop_step0_rows r
  ),
  __pop_step0_agg AS (
    SELECT
      unit_id,
      SUM(value) AS total,
      COALESCE(
        MIN(
          CASE
            WHEN running_total >= 500 THEN ts
          END
        ),
        MAX(ts)
      ) AS match_ts
    FROM
      __pop_step0_running
    GROUP BY
      unit_id
  ),
  __pop_step0 AS (
    SELECT
      a.unit_id,
      a.match_ts AS s0_ts,
      a.match_ts AS qualified_ts
    FROM
      __pop_step0_agg a
    WHERE
      a.total >= 500
  ),
  __pop_step1_running AS (
    SELECT
      r.unit_id,
      r.ts,
      r.value,
      SUM(r.value) OVER (
        PARTITION BY
          r.unit_id
        ORDER BY
          r.ts ROWS BETWEEN UNBOUNDED PRECEDING
          AND CURRENT ROW
      ) AS running_total
    FROM
      __pop_step0 p
      JOIN __pop_step1_rows r ON (r.unit_id = p.unit_id)
    WHERE
      r.ts >= p.s0_ts
  ),
  __pop_step1_agg AS (
    SELECT
      unit_id,
      SUM(value) AS total,
      COALESCE(
        MIN(
          CASE
            WHEN running_total >= 2 THEN ts
          END
        ),
        MAX(ts)
      ) AS match_ts
    FROM
      __pop_step1_running
    GROUP BY
      unit_id
  ),
  __pop_step1 AS (
    SELECT
      p.unit_id,
      p.s0_ts,
      a.match_ts AS s1_ts,
      CASE
        WHEN a.match_ts > p.qualified_ts THEN a.match_ts
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step0 p
      JOIN __pop_step1_agg a ON (a.unit_id = p.unit_id)
    WHERE
      a.total >= 2
  ),
  __population_members AS (
    SELECT
      unit_id AS user_id,
      qualified_ts AS joined_ts
    FROM
      __pop_step1
  )
SELECT
  COUNT(*) AS members
FROM
  __population_members"
`;
