exports[`example Population SQL Bought before, but no visits or orders lately 1`] = `
"WITH
  __pop_ft0 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Orders)
        SELECT
          user_id,
          ordered_at AS timestamp,
          revenue,
          country
        FROM
          shop.orders
      ) t
    WHERE
      timestamp <= '2026-10-15 00:00:00'
  ),
  __pop_ft1 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Events)
        SELECT
          uid,
          event_time,
          event_name,
          path,
          properties
        FROM
          analytics.events
      ) t
    WHERE
      event_time <= '2026-10-15 00:00:00'
      AND (event_name = 'page_view')
  ),
  __pop_step0_rows AS (
    SELECT
      user_id AS unit_id,
      timestamp AS ts
    FROM
      __pop_ft0
    WHERE
      user_id IS NOT NULL
  ),
  __pop_step1_rows AS (
    SELECT
      uid AS unit_id,
      event_time AS ts
    FROM
      __pop_ft1
    WHERE
      uid IS NOT NULL
      AND (event_name = 'page_view')
  ),
  __pop_step2_rows AS (
    SELECT
      user_id AS unit_id,
      timestamp AS ts,
      1 AS value
    FROM
      __pop_ft0
    WHERE
      user_id IS NOT NULL
      AND timestamp >= '2026-07-17 00:00:00'
  ),
  __pop_step0_agg AS (
    SELECT
      r.unit_id,
      MIN(r.ts) AS match_ts
    FROM
      __pop_step0_rows r
    GROUP BY
      r.unit_id
  ),
  __pop_step0 AS (
    SELECT
      a.unit_id,
      a.match_ts AS s0_ts,
      a.match_ts AS qualified_ts
    FROM
      __pop_step0_agg a
  ),
  __pop_step1_agg AS (
    SELECT
      r.unit_id,
      SUM(
        CASE
          WHEN r.ts >= '2026-09-15 00:00:00' THEN 1
          ELSE 0
        END
      ) AS total,
      MAX(
        CASE
          WHEN r.ts < '2026-09-15 00:00:00' THEN r.ts
        END
      ) AS last_ts
    FROM
      __pop_step0 p
      JOIN __pop_step1_rows r ON (r.unit_id = p.unit_id)
    WHERE
      r.ts >= p.s0_ts
    GROUP BY
      r.unit_id
  ),
  __pop_step1 AS (
    SELECT
      p.unit_id,
      p.s0_ts,
      CASE
        WHEN a.last_ts + INTERVAL '2592000 seconds' > p.qualified_ts THEN a.last_ts + INTERVAL '2592000 seconds'
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step0 p
      JOIN __pop_step1_agg a ON (a.unit_id = p.unit_id)
    WHERE
      a.total = 0
    UNION ALL
    SELECT
      p.unit_id,
      p.s0_ts,
      CASE
        WHEN p.s0_ts > p.qualified_ts THEN p.s0_ts
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step0 p
    WHERE
      p.unit_id NOT IN (
        SELECT
          unit_id
        FROM
          __pop_step1_agg
      )
  ),
  __pop_step2_agg AS (
    SELECT
      r.unit_id,
      SUM(r.value) AS total
    FROM
      __pop_step1 p
      JOIN __pop_step2_rows r ON (r.unit_id = p.unit_id)
    WHERE
      r.ts >= p.s0_ts
    GROUP BY
      r.unit_id
  ),
  __pop_step2 AS (
    SELECT
      p.unit_id,
      p.s0_ts,
      CASE
        WHEN CAST('2026-10-15 00:00:00' AS TIMESTAMP) > p.qualified_ts THEN CAST('2026-10-15 00:00:00' AS TIMESTAMP)
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step1 p
      JOIN __pop_step2_agg a ON (a.unit_id = p.unit_id)
    WHERE
      NOT (a.total >= 1)
    UNION ALL
    SELECT
      p.unit_id,
      p.s0_ts,
      CASE
        WHEN CAST('2026-10-15 00:00:00' AS TIMESTAMP) > p.qualified_ts THEN CAST('2026-10-15 00:00:00' AS TIMESTAMP)
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step1 p
    WHERE
      p.unit_id NOT IN (
        SELECT
          unit_id
        FROM
          __pop_step2_agg
      )
  ),
  __population_members AS (
    SELECT
      unit_id AS user_id,
      qualified_ts AS joined_ts
    FROM
      __pop_step2
  )
SELECT
  COUNT(*) AS members
FROM
  __population_members"
`;

