// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`example Population SQL Activated within a week of signing up 1`] = `
"WITH
  __pop_ft0 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Signups)
        SELECT
          user_id,
          created_at AS timestamp,
          plan
        FROM
          app.signups
      ) t
    WHERE
      timestamp <= '2026-10-15 00:00:00'
      AND timestamp >= '2026-07-17 00:00:00'
      AND (plan = 'free')
  ),
  __pop_ft1 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Events)
        SELECT
          uid,
          event_time,
          event_name,
          path,
          properties
        FROM
          analytics.events
      ) t
    WHERE
      event_time <= '2026-10-15 00:00:00'
      AND event_time >= '2026-07-17 00:00:00'
      AND (
        (
          (event_name = 'page_view')
          AND (path = '/pricing')
        )
        OR (event_name = 'trial_started')
      )
  ),
  __pop_step0_rows AS (
    SELECT
      user_id AS unit_id,
      timestamp AS ts
    FROM
      __pop_ft0
    WHERE
      user_id IS NOT NULL
      AND (plan = 'free')
      AND timestamp >= '2026-07-17 00:00:00'
  ),
  __pop_step1_rows AS (
    SELECT
      uid AS unit_id,
      event_time AS ts
    FROM
      __pop_ft1
    WHERE
      uid IS NOT NULL
      AND (event_name = 'page_view')
      AND (path = '/pricing')
  ),
  __pop_step2_rows AS (
    SELECT
      uid AS unit_id,
      event_time AS ts
    FROM
      __pop_ft1
    WHERE
      uid IS NOT NULL
      AND (event_name = 'trial_started')
  ),
  __pop_step0_agg AS (
    SELECT
      r.unit_id,
      MIN(r.ts) AS match_ts
    FROM
      __pop_step0_rows r
    GROUP BY
      r.unit_id
  ),
  __pop_step0 AS (
    SELECT
      a.unit_id,
      a.match_ts AS s0_ts,
      a.match_ts AS qualified_ts
    FROM
      __pop_step0_agg a
  ),
  __pop_step1_agg AS (
    SELECT
      r.unit_id,
      MIN(r.ts) AS match_ts
    FROM
      __pop_step0 p
      JOIN __pop_step1_rows r ON (r.unit_id = p.unit_id)
    WHERE
      r.ts >= p.s0_ts
      AND r.ts <= p.s0_ts + INTERVAL '86400 seconds'
    GROUP BY
      r.unit_id
  ),
  __pop_step1 AS (
    SELECT
      p.unit_id,
      p.s0_ts,
      a.match_ts AS s1_ts,
      CASE
        WHEN a.match_ts > p.qualified_ts THEN a.match_ts
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step0 p
      JOIN __pop_step1_agg a ON (a.unit_id = p.unit_id)
  ),
  __pop_step2_agg AS (
    SELECT
      r.unit_id,
      MIN(r.ts) AS match_ts
    FROM
      __pop_step1 p
      JOIN __pop_step2_rows r ON (r.unit_id = p.unit_id)
    WHERE
      r.ts >= COALESCE(p.s1_ts, p.s0_ts)
      AND r.ts <= COALESCE(p.s1_ts, p.s0_ts) + INTERVAL '604800 seconds'
    GROUP BY
      r.unit_id
  ),
  __pop_step2 AS (
    SELECT
      p.unit_id,
      p.s0_ts,
      p.s1_ts,
      a.match_ts AS s2_ts,
      CASE
        WHEN a.match_ts > p.qualified_ts THEN a.match_ts
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step1 p
      JOIN __pop_step2_agg a ON (a.unit_id = p.unit_id)
  ),
  __population_members AS (
    SELECT
      unit_id AS user_id,
      qualified_ts AS joined_ts
    FROM
      __pop_step2
  )
SELECT
  COUNT(*) AS members
FROM
  __population_members"
`;

exports[`example Population SQL Activated within a week of signing up on BigQuery 1`] = `
"WITH
  __pop_ft0 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Signups)
        SELECT
          user_id,
          created_at AS timestamp,
          plan
        FROM
          app.signups
      ) t
    WHERE
      timestamp <= '2026-10-15 00:00:00'
      AND timestamp >= '2026-07-17 00:00:00'
      AND (plan = 'free')
  ),
  __pop_ft1 AS (
    SELECT
      *
    FROM
      (
        -- Fact Table (Events)
        SELECT
          uid,
          event_time,
          event_name,
          path,
          properties
        FROM
          analytics.events
      ) t
    WHERE
      event_time <= '2026-10-15 00:00:00'
      AND event_time >= '2026-07-17 00:00:00'
      AND (
        (
          (event_name = 'page_view')
          AND (path = '/pricing')
        )
        OR (event_name = 'trial_started')
      )
  ),
  __pop_step0_rows AS (
    SELECT
      user_id AS unit_id,
      CAST(timestamp as DATETIME) AS ts
    FROM
      __pop_ft0
    WHERE
      user_id IS NOT NULL
      AND (plan = 'free')
      AND timestamp >= '2026-07-17 00:00:00'
  ),
  __pop_step1_rows AS (
    SELECT
      uid AS unit_id,
      CAST(event_time as DATETIME) AS ts
    FROM
      __pop_ft1
    WHERE
      uid IS NOT NULL
      AND (event_name = 'page_view')
      AND (path = '/pricing')
  ),
  __pop_step2_rows AS (
    SELECT
      uid AS unit_id,
      CAST(event_time as DATETIME) AS ts
    FROM
      __pop_ft1
    WHERE
      uid IS NOT NULL
      AND (event_name = 'trial_started')
  ),
  __pop_step0_agg AS (
    SELECT
      r.unit_id,
      MIN(r.ts) AS match_ts
    FROM
      __pop_step0_rows r
    GROUP BY
      r.unit_id
  ),
  __pop_step0 AS (
    SELECT
      a.unit_id,
      a.match_ts AS s0_ts,
      a.match_ts AS qualified_ts
    FROM
      __pop_step0_agg a
  ),
  __pop_step1_agg AS (
    SELECT
      r.unit_id,
      MIN(r.ts) AS match_ts
    FROM
      __pop_step0 p
      JOIN __pop_step1_rows r ON (r.unit_id = p.unit_id)
    WHERE
      r.ts >= p.s0_ts
      AND r.ts <= DATETIME_ADD(p.s0_ts, INTERVAL 86400 SECOND)
    GROUP BY
      r.unit_id
  ),
  __pop_step1 AS (
    SELECT
      p.unit_id,
      p.s0_ts,
      a.match_ts AS s1_ts,
      CASE
        WHEN a.match_ts > p.qualified_ts THEN a.match_ts
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step0 p
      JOIN __pop_step1_agg a ON (a.unit_id = p.unit_id)
  ),
  __pop_step2_agg AS (
    SELECT
      r.unit_id,
      MIN(r.ts) AS match_ts
    FROM
      __pop_step1 p
      JOIN __pop_step2_rows r ON (r.unit_id = p.unit_id)
    WHERE
      r.ts >= COALESCE(p.s1_ts, p.s0_ts)
      AND r.ts <= DATETIME_ADD(
        COALESCE(p.s1_ts, p.s0_ts),
        INTERVAL 604800 SECOND
      )
    GROUP BY
      r.unit_id
  ),
  __pop_step2 AS (
    SELECT
      p.unit_id,
      p.s0_ts,
      p.s1_ts,
      a.match_ts AS s2_ts,
      CASE
        WHEN a.match_ts > p.qualified_ts THEN a.match_ts
        ELSE p.qualified_ts
      END AS qualified_ts
    FROM
      __pop_step1 p
      JOIN __pop_step2_agg a ON (a.unit_id = p.unit_id)
  ),
  __population_members AS (
    SELECT
      unit_id AS user_id,
      qualified_ts AS joined_ts
    FROM
      __pop_step2
  )
SELECT
  COUNT(*) AS members
FROM
  __population_members"
`;

