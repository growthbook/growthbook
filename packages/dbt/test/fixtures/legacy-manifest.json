  "semantic_models": {
    "semantic_model.jaffle.orders": {
      "name": "orders",
      "label": "Orders",
      "description": "One row per order",
      "node_relation": {
        "alias": "orders",
        "schema_name": "jaffle",
        "database": "analytics",
        "relation_name": "\"analytics\".\"jaffle\".\"orders\""
      },
      "defaults": { "agg_time_dimension": "ordered_at" },
      "primary_entity": null,
      "entities": [
        { "name": "order_id", "type": "primary", "expr": null },
        { "name": "customer", "type": "foreign", "expr": "customer_id" },
        { "name": "location", "type": "foreign", "expr": "location_id" }
      ],
      "dimensions": [
        {
          "name": "ordered_at",
          "type": "time",
          "expr": null,
          "type_params": { "time_granularity": "day" }
        },
        {
          "name": "delivered_at",
          "type": "time",
          "expr": null,
          "type_params": { "time_granularity": "day" }
        },
        { "name": "is_food_order", "type": "categorical", "expr": null },
        { "name": "order_status", "type": "categorical", "expr": "status" },
        { "name": "item_count", "type": "categorical", "expr": null },
        { "name": "channel", "type": "categorical", "expr": "lower(source)" }
      ],
      "measures": [
        {
          "name": "order_total",
          "agg": "sum",
          "expr": null,
          "create_metric": true,
          "agg_params": null,
          "non_additive_dimension": null,
          "agg_time_dimension": null
        },
        { "name": "order_count", "agg": "count", "expr": "order_id" },
        {
          "name": "customers_with_orders",
          "agg": "count_distinct",
          "expr": "customer_id"
        },
        { "name": "avg_order_value", "agg": "average", "expr": "order_total" },
        {
          "name": "large_orders",
          "agg": "sum_boolean",
          "expr": "order_total > 50"
        },
        {
          "name": "order_total_p90",
          "agg": "percentile",
          "expr": "order_total",
          "agg_params": {
            "percentile": 0.9,
            "use_discrete_percentile": false,
            "use_approximate_percentile": false
          }
        },
        { "name": "min_order_total", "agg": "min", "expr": "order_total" },
        {
          "name": "distinct_order_totals",
          "agg": "count_distinct",
          "expr": "order_total"
        },
        { "name": "order_cost", "agg": "sum", "expr": "cost_amount" },
        {
          "name": "net_revenue",
          "agg": "sum",
          "expr": "order_total - discount_amount"
        },
        {
          "name": "orders_with_discount",
          "agg": "sum",
          "expr": "discount_amount",
          "non_additive_dimension": {
            "name": "ordered_at",
            "window_choice": "min",
            "window_groupings": []
          }
        },
        {
          "name": "order_total_by_delivery",
          "agg": "sum",
          "expr": "order_total",
          "agg_time_dimension": "delivered_at"
        }
      ],
      "config": { "meta": { "growthbook": { "projects": ["prj_abc"] } } },
      "tags": ["core"]
    },
    "semantic_model.jaffle.customers": {
      "name": "customers",
      "label": "Customers",
      "node_relation": {
        "relation_name": "\"analytics\".\"jaffle\".\"customers\""
      },
      "defaults": { "agg_time_dimension": "first_ordered_at" },
      "primary_entity": null,
      "entities": [
        { "name": "customer", "type": "primary", "expr": "customer_id" }
      ],
      "dimensions": [
        {
          "name": "first_ordered_at",
          "type": "time",
          "expr": null,
          "type_params": { "time_granularity": "day" }
        },
        { "name": "region", "type": "categorical", "expr": null },
        { "name": "key", "type": "categorical", "expr": "account_key" },
        {
          "name": "country",
          "type": "categorical",
          "expr": "upper(country_code)"
        }
      ],
      "measures": [],
      "config": { "meta": {} },
      "tags": []
    },
    "semantic_model.jaffle.visits": {
      "name": "visits",
      "node_relation": {
        "relation_name": "\"analytics\".\"jaffle\".\"visits\""
      },
      "defaults": { "agg_time_dimension": "visited_at" },
      "primary_entity": null,
      "entities": [
        { "name": "visit_id", "type": "primary", "expr": null },
        { "name": "user", "type": "foreign", "expr": "user_id" }
      ],
      "dimensions": [
        {
          "name": "visited_at",
          "type": "time",
          "expr": null,
          "type_params": { "time_granularity": "day" }
        },
        { "name": "referrer", "type": "categorical", "expr": null },
        { "name": "product", "type": "categorical", "expr": null }
      ],
      "measures": [
        { "name": "visits", "agg": "count", "expr": "visit_id" },
        { "name": "buys", "agg": "count", "expr": "purchase_id" }
      ],
      "config": { "meta": {} },
      "tags": []
    },
    "semantic_model.jaffle.refunds": {
      "name": "refunds",
      "node_relation": {
        "relation_name": "\"analytics\".\"jaffle\".\"refunds\""
      },
      "defaults": { "agg_time_dimension": "refunded_at" },
      "primary_entity": null,
      "entities": [
        { "name": "refund_id", "type": "primary", "expr": null },
        { "name": "customer", "type": "foreign", "expr": "customer_id" }
      ],
      "dimensions": [
        {
          "name": "refunded_at",
          "type": "time",
          "expr": null,
          "type_params": { "time_granularity": "day" }
        }
      ],
      "measures": [
        { "name": "refund_count", "agg": "count", "expr": "refund_id" }
      ],
      "config": { "meta": { "growthbook": { "enabled": false } } },
      "tags": []
    }
  },
