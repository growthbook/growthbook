{
  "name": "dummy-shop",
  "private": true,
  "version": "0.1.0",
  "description": "Fake e-commerce storefront for GrowthBook dogfooding (flags, experiments, analytics)",
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/ensure-sdk-dist.mjs",
    "dev": "vite",
    "prebuild": "node ./scripts/ensure-sdk-dist.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "@growthbook/growthbook": "workspace:*",
    "@growthbook/growthbook-react": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "18.0.15",
    "@types/react-dom": "18.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "rimraf": "^3.0.2",
    "typescript": "5.7.3",
    "vite": "^6.0.7"
  }
}
