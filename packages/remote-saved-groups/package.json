{
  "name": "@growthbook/remote-saved-groups",
  "version": "0.1.0",
  "description": "Parse and validate remote saved group files for GrowthBook and its loaders",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/growthbook/growthbook",
    "directory": "packages/remote-saved-groups"
  },
  "scripts": {
    "build:clean": "rimraf dist tsconfig.tsbuildinfo",
    "build:typescript": "tsc",
    "build": "pnpm build:clean && pnpm build:typescript",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "jest",
    "clean": "rimraf node_modules",
    "type-check": "tsgo --pretty --noEmit"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260309.1",
    "@swc/core": "^1.3.4",
    "@swc/jest": "^0.2.23",
    "@types/jest": "^27.0.1",
    "@types/node": "^22.8.6",
    "jest": "^27.1.1",
    "rimraf": "^3.0.2",
    "typescript": "5.7.3"
  }
}
